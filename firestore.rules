rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "PGqf01S0DzVEOEuEC0fzJikIFSJ3";
    }

    match /downloads/{fileId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'title', 'category', 'link', 'thumbnail', 'description', 'createdAt', 'uploadedBy'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.category in ['video', 'apk']
        && request.resource.data.link is string
        && request.resource.data.link.size() <= 2048
        && request.resource.data.link.matches('https://.*')
        && request.resource.data.thumbnail is string
        && request.resource.data.thumbnail.size() <= 2048
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 300
        && request.resource.data.uploadedBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
